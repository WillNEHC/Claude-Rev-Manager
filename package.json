{
  "name": "gdip",
  "version": "0.1.0",
  "private": true,
  "description": "Guest Demand Intelligence Platform — market research for luxury NH short-term rentals.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "markets:sync": "tsx src/jobs/sync-markets.ts",
    "ingest": "tsx src/jobs/ingest.ts",
    "research": "tsx src/jobs/research.ts",
    "extract": "tsx src/jobs/extract.ts",
    "embed": "tsx src/jobs/embed.ts",
    "enrich": "tsx src/jobs/enrich.ts",
    "backfill": "tsx src/jobs/backfill.ts",
    "monitor": "tsx src/jobs/monitor.ts",
    "pipeline:monthly": "tsx src/jobs/monthly-pipeline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^14.2.15",
    "pino": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "gdip": {
    "note": "Phase 1 (data spine + Airbnb ingestion slice). The Firecrawl SDK (@mendable/firecrawl-js) and Anthropic SDK are added in their phases; Phase 1 keeps the Firecrawl call behind an injectable HTTP-ish interface so parsing/dedup/filtering logic is testable without network or keys. Next.js dashboard is scaffolded in Phase 4."
  }
}
