# =============================================================================
# GDIP — Guest Demand Intelligence Platform
# Environment configuration template. Copy to `.env.local` and fill in.
# NEVER commit real secrets. `.env.local` is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Settings > API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (used by migration tooling / batch jobs).
DATABASE_URL=

# Public vars for the Next.js dashboard (safe to expose to the client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Firecrawl (ingestion) ---------------------------------------------------
FIRECRAWL_API_KEY=
# Requests/second ceiling enforced by our rate limiter (see docs/04).
FIRECRAWL_MAX_RPS=2
FIRECRAWL_MAX_CONCURRENCY=4

# --- LLM / Embeddings (AI extraction + RAG) ----------------------------------
# Anthropic Claude powers structured extraction, categorization, and RAG answers.
ANTHROPIC_API_KEY=
# Default models. Extraction favors a cost-efficient model; synthesis uses a stronger one.
GDIP_EXTRACTION_MODEL=claude-haiku-4-5-20251001
GDIP_SYNTHESIS_MODEL=claude-opus-4-8
# Embedding provider for the vector store (pgvector). See docs/07.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- PriceLabs (optional revenue-data enrichment) ----------------------------
# Used to attach market rate/occupancy context to recommendations & ROI models.
PRICELABS_API_KEY=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Historical ingestion window in months (default per spec: 6-12).
GDIP_HISTORY_WINDOW_MONTHS=12
